# CHIC-AI Test Automation - Environment Variables
# IMPORTANT: Copy this file to .env and fill in actual values
# .env is gitignored and should NEVER be committed

# ====================
# Test Environment
# ====================
ENVIRONMENT=dev
# Options: dev, staging, production, ci

# ====================
# Test Credentials
# ====================
# Valid Test User
TEST_EMAIL=john.smith@test.com
TEST_PASSWORD=ValidPass@123
TEST_FULL_NAME=John Smith

# Admin User (if needed)
ADMIN_EMAIL=admin@chic-ai.com
ADMIN_PASSWORD=SecureAdminPass@456

# Invalid Credentials (for negative testing)
INVALID_EMAIL=invalid@test.com
INVALID_PASSWORD=WrongPassword123

# ====================
# Signup Test Credentials
# ====================
# New user for signup testing (email should NOT exist)
SIGNUP_TEST_NAME=Robert Johnson
SIGNUP_TEST_EMAIL=robert.new@test.com
SIGNUP_TEST_PASSWORD=SecurePass@123

# Duplicate email test (email should already exist)
DUPLICATE_EMAIL=existing.user@test.com

# ====================
# Application URLs
# ====================
DEV_URL=http://localhost:5173
STAGING_URL=https://staging.chic-ai.com
PROD_URL=https://app.digitalstylist.com
BASE_URL=https://app.digitalstylist.com  # Current test environment

# Chat page specific
CHAT_URL=https://app.digitalstylist.com/chat

# ====================
# API Configuration (if needed)
# ====================
API_BASE_URL=http://localhost:3000/api
API_KEY=your_api_key_here

# ====================
# Database (if needed for data setup)
# ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chic_ai_test
DB_USER=test_user
DB_PASSWORD=test_password

# ====================
# Reporting & Notifications
# ====================
# Slack webhook for test results (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email for test reports (optional)
REPORT_EMAIL=qa-team@chic-ai.com

# ====================
# Browser Settings
# ====================
HEADLESS=false
BROWSER=chromium
# Options: chromium, firefox, webkit

# ====================
# Parallel Execution
# ====================
PARALLEL_WORKERS=4

# ====================
# Test Data
# ====================
TEST_DATA_PATH=test_data/

# ====================
# CI/CD Specific
# ====================
# Set to true when running in CI
CI_MODE=false

# GitHub Token (for API access in CI)
GITHUB_TOKEN=your_github_token_here
