  "test_scenarios": {
    "new_user_first_chat": {
      "description": "New user starting first conversation",
      "messages": [
        "Hi, I'm new here",
        "Can you help me find my style?",
        "I'm not sure what looks good on me"
      ],
      "expected_response_contains": ["welcome", "help", "style", "profile"]
    },
    "returning_user": {
      "description": "Returning user with existing profile",
      "messages": [
        "Hello again",
        "Based on my previous choices, what do you suggest?"
      ],
      "expected_response_contains": ["preferences", "profile", "recommend"]
    },
    "urgent_event": {
      "description": "User needs outfit for urgent event",
      "messages": [
        "I have an event tonight!",
        "Need an outfit ASAP",
        "Something elegant and classy"
      ],
      "expected_response_contains": ["outfit", "elegant", "suggest", "recommend"]
    }
  },

  "error_scenarios": {
    "network_failure": {
      "description": "Simulated network disconnection",
      "action": "disconnect_network",
      "expected": "error_message_displayed"
    },
    "slow_response": {
      "description": "AI takes long time to respond",
      "timeout": 30000,
      "expected": "loading_indicator_or_timeout_message"
    },
    "invalid_response": {
      "description": "AI returns invalid/corrupted response",
      "expected": "error_handling_graceful"
    }
  }
